# Enlaces a las skills, no su contenido.
#
# El contenido real de las skills se versiona en `.agents/skills/`, y Claude Code
# lee esa carpeta directamente. `npx skills add` crea además enlaces aquí, que no
# hacen falta y que git en Windows no guarda como enlaces: los convierte en
# ficheros de texto con la ruta dentro. Se ignoran para que no ensucien el repo.
.claude/skills/

# Lockfile de skills. Se ignora a propósito: el contenido real está versionado en
# `.agents/skills/`, que es la única garantía de que siga existiendo. `npx skills
# add` regenera este fichero en cada instalación, y no queremos que vuelva al repo.
# El origen y el hash de las skills de upstream están en AGENTS.md § Skills.
skills-lock.json

# Configuración local de Claude Code (por máquina, no por proyecto)
.claude/settings.local.json

# Secretos. Nunca entran al repositorio.
.env
.env.*
!.env.example

# Salidas de ejecución: no se conservan ni se versionan.
salida/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node
node_modules/
dist/
build/

# Bases de datos locales
*.db
*.sqlite
*.sqlite3
