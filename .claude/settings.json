{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'backend','hooks','validar_capitulo.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'backend','hooks','policy.py'),run_name='__main__')\""
          }
        ]
      }
    ]
  }
}
